{
  "name": "mealie-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP (HTTP, red local) para gestionar Mealie: recetas, ingredientes, lista de la compra y menú semanal.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "deploy:app": "bash addon/deploy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
