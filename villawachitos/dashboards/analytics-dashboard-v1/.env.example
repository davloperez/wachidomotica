# Copia este archivo a `.env` (está en .gitignore) y rellena los valores.

# URL de Home Assistant accesible desde este ordenador (sin barra final).
HA_URL=http://homeassistant.local:8123

# Token de acceso de larga duración (Perfil → Seguridad → Tokens de acceso de larga duración).
# Se usa en `npm run dev` (datos reales) y en el deploy (para registrar el recurso de Lovelace).
HA_TOKEN=

# Acceso SSH a Home Assistant (app "Terminal & SSH" con tu clave pública en authorized_keys).
HA_SSH_HOST=homeassistant.local
HA_SSH_PORT=22
HA_SSH_USER=root
# Opcional: clave privada concreta (por defecto usa el agente / ~/.ssh/config).
# HA_SSH_KEY=~/.ssh/id_ed25519

# Carpeta de destino dentro de HA. /config/www se sirve como /local.
HA_WWW_DIR=/config/www/analytics-dashboard-v1
