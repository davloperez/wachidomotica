    },
    "views": [
      {
        "title": "Oficina 2",
        "path": "oficina-2",
        "icon": "mdi:laptop",
        "type": "sections",
        "max_columns": 1,
        "sections": [
          {
            "type": "grid",
            "cards": [
              {
                "type": "heading",
                "heading": "Oficina 2",
                "heading_style": "title",
                "icon": "mdi:laptop",
                "badges": [
                  {
                    "type": "button",
                    "icon": "mdi:sofa",
                    "text": "Salón",
                    "color": "disabled",
                    "tap_action": {
                      "action": "navigate",
                      "navigation_path": "/shelly-salon-este/salon"
                    }
                  },
                  {
                    "type": "button",
                    "icon": "mdi:desk",
                    "text": "Oficina 1",
                    "tap_action": {
                      "action": "navigate",
                      "navigation_path": "/shelly-x2i-oficina-1/oficina-1"
                    },
                    "color": "disabled"
                  },
                  {
                    "type": "button",
                    "icon": "mdi:laptop",
                    "text": "Oficina 2",
                    "tap_action": {
                      "action": "navigate",
                      "navigation_path": "/shelly-x2i-oficina-2/oficina-2"
                    },
                    "color": "primary"
                  }
                ]
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"error\" title=\"SAI en batería\">Corte de luz en la oficina. Autonomía: {{ states('sensor.eaton_autonomia_de_la_bateria') | float(0) | round(0) | int }} min · Batería {{ states('sensor.eaton_ellipse_eco_800_carga_de_la_bateria') }} %</ha-alert>",
                "visibility": [
                  {
                    "condition": "template",
                    "value_template": "{{ 'OB' in states('sensor.eaton_ellipse_eco_800_datos_de_estado') }}"
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"error\" title=\"¡Fuga de agua!\">Se ha detectado una fuga de agua en casa.</ha-alert>",
                "visibility": [
                  {
                    "condition": "state",
                    "entity": "input_boolean.alerta_fuga_agua",
                    "state": "on"
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"warning\" title=\"Robot aspirador con error\">{{ state_attr('vacuum.limpiasuelos', 'error') or 'Revisa el Limpiasuelos.' }}</ha-alert>",
                "visibility": [
                  {
                    "condition": "state",
                    "entity": "vacuum.limpiasuelos",
                    "state": "error"
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"warning\" title=\"Tinta baja en la Epson\">{% set t = {'Negro':'sensor.epson_et_5150_series_black_ink','Cian':'sensor.epson_et_5150_series_cyan_ink','Magenta':'sensor.epson_et_5150_series_magenta_ink','Amarillo':'sensor.epson_et_5150_series_yellow_ink'} %}{% for n, e in t.items() if states(e) | float(100) < 15 %}{{ n }} {{ states(e) }} %{{ ' · ' if not loop.last }}{% endfor %}</ha-alert>",
                "visibility": [
                  {
                    "condition": "or",
                    "conditions": [
                      {
                        "condition": "numeric_state",
                        "entity": "sensor.epson_et_5150_series_black_ink",
                        "below": 15
                      },
                      {
                        "condition": "numeric_state",
                        "entity": "sensor.epson_et_5150_series_cyan_ink",
                        "below": 15
                      },
                      {
                        "condition": "numeric_state",
                        "entity": "sensor.epson_et_5150_series_magenta_ink",
                        "below": 15
                      },
                      {
                        "condition": "numeric_state",
                        "entity": "sensor.epson_et_5150_series_yellow_ink",
                        "below": 15
                      }
                    ]
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"info\" title=\"Alarma armada\">Estado: {{ states('alarm_control_panel.alarma_vivienda') | replace('armed_away','Total') | replace('armed_home','En casa') | replace('armed_night','Noche') | replace('triggered','¡DISPARADA!') }}</ha-alert>",
                "visibility": [
                  {
                    "condition": "state",
                    "entity": "alarm_control_panel.alarma_vivienda",
                    "state_not": "disarmed"
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "markdown",
                "content": "<ha-alert alert-type=\"info\" title=\"Modo silencio activado\">Las notificaciones sonoras están silenciadas.</ha-alert>",
                "visibility": [
                  {
                    "condition": "state",
                    "entity": "input_boolean.modo_silencio",
                    "state": "on"
                  }
                ],
                "grid_options": {
                  "columns": 12,
                  "rows": "auto"
                }
              },
              {
                "type": "heading",
                "heading": "Llaman a la puerta",
                "heading_style": "title",
                "icon": "mdi:doorbell-video",
                "visibility": [
                  {
                    "condition": "or",
                    "conditions": [
                      {
                        "condition": "state",
                        "entity": "binary_sensor.jardin_norte_portero_automatico_exterior_duox_doorbell_zero",
                        "state": "on"
                      },
                      {
                        "condition": "template",
                        "value_template": "{{ (now() - as_datetime(states('event.jardin_norte_portero_automatico_exterior_duox_doorbell'), now())).total_seconds() < 180 }}"
                      }
                    ]
                  }
                ]
              },
