{
  "version": "2.0.0",
  "inputs": [],
  "tasks": [
    /* =====================================================================
     * Functional v2  (villawachitos/dashboards/functional-v2)
     * ===================================================================== */
    {
      "label": "Functional v2: instalar dependencias",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/villawachitos/dashboards/functional-v2" },
      "problemMatcher": []
    },
    {
      "label": "Functional v2: servidor de desarrollo",
      "detail": "Vite en http://localhost:5176/dev/index.html (datos reales si hay .env; ?mock para simulados)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/dashboards/functional-v2",
        "env": { "VITE_USE_POLLING": "1" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegin": ".", "beginsPattern": "VITE v", "endsPattern": "Local:" }
      }
    },
    {
      "label": "Functional v2: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/villawachitos/dashboards/functional-v2" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Functional v2: deploy a Home Assistant",
      "detail": "Build + subida por SSH + recurso Lovelace con ?v=hash + dashboard functional-v2",
      "type": "shell",
      "command": "npm run deploy",
      "options": { "cwd": "${workspaceFolder}/villawachitos/dashboards/functional-v2" },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Functional v2: typecheck y lint",
      "type": "shell",
      "command": "npm run typecheck && npm run lint",
      "options": { "cwd": "${workspaceFolder}/villawachitos/dashboards/functional-v2" },
      "group": "test",
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    },

    /* =====================================================================
     * ESPHome  (villawachitos/esphome)
     * ===================================================================== */
    {
      "label": "ESPHome: crear/actualizar entorno Python",
      "detail": "Recrea villawachitos/esphome/venv con la versión actual de Python e instala ESPHome",
      "type": "shell",
      "command": "rm -rf venv && python3 -m venv venv && venv/bin/pip install --upgrade pip esphome",
      "options": { "cwd": "${workspaceFolder}/villawachitos/esphome" },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: compilar archivo actual",
      "type": "shell",
      "command": "esphome compile '${file}'",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/esphome",
        "env": { "PATH": "${workspaceFolder}/villawachitos/esphome/venv/bin:${env:PATH}" }
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: subir archivo actual (OTA)",
      "type": "shell",
      "command": "esphome upload '${file}'",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/esphome",
        "env": { "PATH": "${workspaceFolder}/villawachitos/esphome/venv/bin:${env:PATH}" }
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: logs del archivo actual",
      "type": "shell",
      "command": "esphome logs '${file}'",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/esphome",
        "env": { "PATH": "${workspaceFolder}/villawachitos/esphome/venv/bin:${env:PATH}" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ESPHome: compilar todos",
      "type": "shell",
      "command": "./run_all.sh compile",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/esphome",
        "env": { "PATH": "${workspaceFolder}/villawachitos/esphome/venv/bin:${env:PATH}" }
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: subir todos (OTA)",
      "type": "shell",
      "command": "./run_all.sh upload",
      "options": {
        "cwd": "${workspaceFolder}/villawachitos/esphome",
        "env": { "PATH": "${workspaceFolder}/villawachitos/esphome/venv/bin:${env:PATH}" }
      },
      "problemMatcher": []
    }
  ]
}
